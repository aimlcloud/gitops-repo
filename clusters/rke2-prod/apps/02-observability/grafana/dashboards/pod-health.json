{
  "id": null,
  "title": "Pod Health Overview",
  "tags": ["kubernetes", "pods", "health"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "graph",
      "title": "Pod Restarts (CrashLooping)",
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total[10m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "OOMKilled Pods",
      "targets": [
        {
          "expr": "kube_pod_container_status_last_terminated_reason == \"OOMKilled\"",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Pending Pods",
      "targets": [
        {
          "expr": "kube_pod_status_phase{phase=\"Pending\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Pod CPU Usage",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total[5m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Pod Memory Usage",
      "targets": [
        {
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{pod}}"
        }
      ],
      "datasource": "Prometheus"
    }
  ]
}

