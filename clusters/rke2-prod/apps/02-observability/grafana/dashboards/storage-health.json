{
  "id": null,
  "title": "Storage Health Overview",
  "tags": ["kubernetes", "storage", "health"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "graph",
      "title": "PVC Usage",
      "targets": [
        {
          "expr": "1 - (kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes)",
          "legendFormat": "{{persistentvolumeclaim}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Disk IO Time",
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Disk Read Errors",
      "targets": [
        {
          "expr": "rate(node_disk_read_errors_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "type": "graph",
      "title": "Disk Write Errors",
      "targets": [
        {
          "expr": "rate(node_disk_write_errors_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "datasource": "Prometheus"
    }
  ]
}

